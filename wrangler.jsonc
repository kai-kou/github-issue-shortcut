{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "github-issue-shortcut",
  "compatibility_date": "2026-07-09",
  "main": "./worker/index.ts",
  // GitHub App の Client ID は公開値（認可 URL に出る）。secret ではないため vars に置き、
  // デプロイでダッシュボードの plaintext var が上書き消去される問題を防ぐ。Client Secret / 暗号鍵は Workers Secrets。
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23livFCo9vcWDm0zyg",
    // トークン Cookie の鍵バージョン（1〜255）。TOKEN_ENCRYPTION_KEY をローテーションするときに
    // +1 する。旧鍵で発行された Cookie は復号されず再ログインになるだけで、端末内のデータ
    // （下書き・ショートカット）は失われない（docs/design/stateless-architecture.md §4）。
    "TOKEN_KEY_VERSION": "1"
  },
  "assets": {
    // directory は miniflare のテスト環境（vitest-pool-workers）が静的アセットを解決するために必要
    // （docs/testing-e2e.md: これを消すとローカル unit テストが壊れる）。binding は Worker から
    // アセットを取得する将来の用途のために残す（#98 の動的 manifest 撤去後は未使用）。
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // manifest はユーザーごとの差し替えをやめ静的アセットのまま返す（P1・stateless-architecture.md §7）。
    "run_worker_first": ["/api/*", "/auth/*", "/setup"]
  },
  // 起票のアプリ側レート制限（PR-4・OQ-6）。カウンタは Cloudflare が管理し、Worker は永続層を持たない
  // （P3・stateless-architecture.md §3）。データセンター単位の best-effort でグローバル厳密ではないため、
  // スパム抑止の一次防御として使う（厳密なカウントを前提にした表示・テストにしないこと）。
  "ratelimits": [
    {
      // 本番の上限: 起票 10 件/分（GitHub の二次制限 80 req/min の 1/8）。
      // `period` を変えるときは `worker/index.ts` の ISSUE_RATE_LIMIT_WINDOW_SECONDS（429 の
      // Retry-After に使う）も必ず合わせること（binding から period を読む API が無いため二重管理）。
      "name": "ISSUE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // E2E 専用の緩い上限（`ISSUE_RATE_LIMIT_RELAXED_ENABLED=1` のときだけ使う）。E2E は単一の
      // モックユーザーを全 spec が使い回すため、本番の上限では後半のテストが 429 で落ちる
      // （テスト分離の問題であってアプリのバグではない）。本番では参照されない。
      "name": "ISSUE_RATE_LIMIT_RELAXED",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      // 同一内容の連投抑止（不正利用対策・PR-4 拡張・#179）。HMAC(userId + contentHash) をキーにし、
      // サーバーに内容を一切保存せず「同一ユーザー・同一内容の起票は 10 秒に 1 回まで」を強制する。
      // period は 10/60 しか選べない（旧サーバー実装の 30 秒窓とは粒度が変わる・stateless-architecture.md §6）。
      "name": "ISSUE_DUPLICATE_SUBMISSION_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 1, "period": 10 }
    },
    {
      // E2E 専用の緩い上限（`ISSUE_RATE_LIMIT_RELAXED_ENABLED=1` のときだけ使う）。単一モックユーザーが
      // 複数 spec で同一内容（例: マジック文字列 `__mock_422__`）を短時間に繰り返し送るため、本番の
      // 10 秒窓のままだと無関係なテストが 429 で落ちる。本番では参照されない。
      "name": "ISSUE_DUPLICATE_SUBMISSION_LIMIT_RELAXED",
      "namespace_id": "1004",
      "simple": { "limit": 1000, "period": 10 }
    }
  ],
  // Workers Logs（既定は有効・サンプリング 100%・invocation log 有効）。未設定のままだと
  // invocation log が Request / Response のヘッダーごと記録するため、トークン Cookie が
  // Cloudflare 側に残り「サーバーに個人データを保持しない」が成立しない（P4・§8）。
  // invocation log を無効化し、残すのは例外（uncaught exception）だけにする。それも 5% に
  // 絞る（保持ゼロ優先のトレードオフ。全数の障害調査が要るときだけ一時的に引き上げる）。
  // 保持期間は Cloudflare 側の上限（無料プラン 3 日 / 有料プラン 7 日）。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "invocation_logs": false
    }
  },
  // Cron Trigger は使わない。**キーを消すのではなく空配列を明示する**のが仕様上の要件で、
  // 公式が「To disable a Cron Trigger, set `crons = []`. Commenting out the `crons` key will not
  // disable a Cron Trigger.」と明記している（wrangler configuration）。
  // 実際 P3（#178）で D1 `issue_log` クリーンアップ用の `triggers` ブロックごと削除したところ、
  // Cloudflare 側の登録（`0 3 * * *`）だけが残り、`scheduled` ハンドラ不在のまま毎日発火して
  // 失敗し続けていた（#216）。この空配列は「Cron を使わない」の意思表示であり、消してはいけない。
  "triggers": {
    "crons": []
  }
  // D1 は P1〜P3 で全用途が移設され、バインディングと migrations/ は P4（#166）で撤去した。
  // Worker は永続化 API（D1 / KV / R2 / DO）をひとつも持たない。
}
