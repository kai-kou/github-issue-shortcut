{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "github-issue-shortcut",
  "compatibility_date": "2026-07-09",
  "main": "./worker/index.ts",
  // GitHub App の Client ID は公開値（認可 URL に出る）。secret ではないため vars に置き、
  // デプロイでダッシュボードの plaintext var が上書き消去される問題を防ぐ。Client Secret / 暗号鍵は Workers Secrets。
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23livFCo9vcWDm0zyg",
    // トークン Cookie の鍵バージョン（1〜255）。TOKEN_ENCRYPTION_KEY をローテーションするときに
    // +1 する。旧鍵で発行された Cookie は復号されず再ログインになるだけで、端末内のデータ
    // （下書き・ショートカット）は失われない（docs/design/stateless-architecture.md §4）。
    "TOKEN_KEY_VERSION": "1"
  },
  "assets": {
    // directory は miniflare のテスト環境（vitest-pool-workers）が静的アセットを解決するために必要
    // （docs/testing-e2e.md: これを消すとローカル unit テストが壊れる）。binding は Worker から
    // アセットを取得する将来の用途のために残す（#98 の動的 manifest 撤去後は未使用）。
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // manifest はユーザーごとの差し替えをやめ静的アセットのまま返す（P1・stateless-architecture.md §7）。
    "run_worker_first": ["/api/*", "/auth/*", "/setup"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-issue-shortcut-db",
      "database_id": "8c403d10-29b8-4a51-9f63-9e79b19aed46",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // issue_log の保持期間クリーンアップ（#71）。毎日 03:00 UTC（12:00 JST・オフピーク）に実行。
    "crons": ["0 3 * * *"]
  }
}
