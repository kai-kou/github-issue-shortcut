{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "github-issue-shortcut",
  "compatibility_date": "2026-07-09",
  "main": "./worker/index.ts",
  // GitHub App の Client ID は公開値（認可 URL に出る）。secret ではないため vars に置き、
  // デプロイでダッシュボードの plaintext var が上書き消去される問題を防ぐ。Client Secret / 暗号鍵は Workers Secrets。
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23livFCo9vcWDm0zyg",
    // トークン Cookie の鍵バージョン（1〜255）。TOKEN_ENCRYPTION_KEY をローテーションするときに
    // +1 する。旧鍵で発行された Cookie は復号されず再ログインになるだけで、端末内のデータ
    // （下書き・ショートカット）は失われない（docs/design/stateless-architecture.md §4）。
    "TOKEN_KEY_VERSION": "1"
  },
  "assets": {
    // directory は miniflare のテスト環境（vitest-pool-workers）が静的アセットを解決するために必要
    // （docs/testing-e2e.md: これを消すとローカル unit テストが壊れる）。binding は Worker から
    // アセットを取得する将来の用途のために残す（#98 の動的 manifest 撤去後は未使用）。
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // manifest はユーザーごとの差し替えをやめ静的アセットのまま返す（P1・stateless-architecture.md §7）。
    "run_worker_first": ["/api/*", "/auth/*", "/setup"]
  },
  // 起票のアプリ側レート制限（PR-4・OQ-6）。カウンタは Cloudflare が管理し、Worker は永続層を持たない
  // （P3・stateless-architecture.md §3）。データセンター単位の best-effort でグローバル厳密ではないため、
  // スパム抑止の一次防御として使う（厳密なカウントを前提にした表示・テストにしないこと）。
  "ratelimits": [
    {
      // 本番の上限: 起票 10 件/分（GitHub の二次制限 80 req/min の 1/8）。
      // `period` を変えるときは `worker/index.ts` の ISSUE_RATE_LIMIT_WINDOW_SECONDS（429 の
      // Retry-After に使う）も必ず合わせること（binding から period を読む API が無いため二重管理）。
      "name": "ISSUE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // E2E 専用の緩い上限（`ISSUE_RATE_LIMIT_RELAXED_ENABLED=1` のときだけ使う）。E2E は単一の
      // モックユーザーを全 spec が使い回すため、本番の上限では後半のテストが 429 で落ちる
      // （テスト分離の問題であってアプリのバグではない）。本番では参照されない。
      "name": "ISSUE_RATE_LIMIT_RELAXED",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  // D1（バインディング・migrations）は P3 で全ての利用が無くなった。撤去そのものは P4（#166）で行う。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-issue-shortcut-db",
      "database_id": "8c403d10-29b8-4a51-9f63-9e79b19aed46",
      "migrations_dir": "migrations"
    }
  ]
}
